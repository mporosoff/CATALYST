# Backend-only values. In production use Sites runtime environment settings.
# Mark SCISURE_API_TOKEN as a secret; never add a public frontend prefix.
SCISURE_BASE_URL=https://sandbox.elabjournal.com
SCISURE_API_TOKEN=
SITE_ORIGIN=http://localhost:5173
# Enable only on the owner-private site for initial owner enrollment.
ALLOW_OWNER_BOOTSTRAP=true
# Destination verification and immutable approval are also required by the server.
SCISURE_PUBLICATION_ENABLED=false
