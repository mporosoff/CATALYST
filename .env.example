# Proposed backend-only configuration; the application is not implemented yet.
# Use the deployment platform's secret store for SCISURE_API_TOKEN.
# Never use a public frontend prefix for these configuration values.
SCISURE_BASE_URL=https://sandbox.elabjournal.com
SCISURE_API_TOKEN=
SCISURE_GROUP_ID=

# Publication must remain disabled until the tenant, destination, and permissions
# have been verified. Application implementation must enforce this setting.
SCISURE_PUBLICATION_ENABLED=false
